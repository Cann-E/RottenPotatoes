<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · RottenPotatoes" : "RottenPotatoes" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rottenpotatoes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <%= link_to movies_path, class: "brand" do %>
          <span class="brand-icon" aria-hidden="true">🥔</span> RottenPotatoes
        <% end %>
        <nav class="site-nav" aria-label="Main menu">
          <%= link_to "All Movies", movies_path,
                class: ["nav-link", ("active" if current_page?(movies_path))],
                "aria-current": (current_page?(movies_path) ? "page" : nil) %>
          <%= link_to "+ Add a Movie", new_movie_path,
                class: ["nav-button", ("active" if current_page?(new_movie_path))],
                "aria-current": (current_page?(new_movie_path) ? "page" : nil) %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if notice.present? %>
        <p class="flash flash-notice" role="status"><span aria-hidden="true">✓</span> <%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="flash flash-alert" role="alert"><span aria-hidden="true">!</span> <%= alert %></p>
      <% end %>

      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">&copy; <%= Date.current.year %> RottenPotatoes · A simple movie catalog</div>
    </footer>
  </body>
</html>
