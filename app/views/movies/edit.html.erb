<% content_for :title, "Editing #{@movie.title}" %>

<section class="card">
  <h1>Editing “<%= @movie.title %>”</h1>

  <%= render "form", movie: @movie %>

  <div class="button-row">
    <%= link_to "Show this movie", @movie, class: "button button-secondary" %>
    <%= link_to "Back to movies", movies_path, class: "button button-secondary" %>
  </div>
</section>
