<% content_for :title, "Edit #{@movie.title}" %>

<%= link_to "← Back to #{@movie.title}", @movie, class: "back-link" %>

<section class="card">
  <h1>Edit Movie</h1>
  <p class="subtitle">Change anything you like, then click <strong>Save changes</strong>.</p>

  <%= render "form", movie: @movie, cancel_path: movie_path(@movie) %>
</section>
