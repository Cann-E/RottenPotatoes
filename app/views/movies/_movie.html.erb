<article id="<%= dom_id movie %>" class="movie-details">
  <%= displayposter(movie, "large") %>

  <div class="movie-info">
    <p class="eyebrow"><%= movie.release_date ? movie.release_date.year : "Movie" %></p>
    <h1><%= movie.title %></h1>
    <dl>
      <dt>Rating</dt>
      <dd><% if movie.rating.present? %><span class="rating-badge"><%= movie.rating %></span><% else %><span class="muted">Not rated</span><% end %></dd>

      <dt>Release date</dt>
      <dd><%= displaydate(movie) %></dd>

      <dt>Description</dt>
      <dd><%= movie.description.presence || content_tag(:span, "No description yet.", class: "muted") %></dd>
    </dl>
  </div>
</article>
