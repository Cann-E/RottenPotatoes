<article id="<%= dom_id movie %>" class="movie-details">
  <h1><%= movie.title %></h1>
  <dl>
    <dt>Rating</dt>
    <dd><% if movie.rating.present? %><span class="rating-badge"><%= movie.rating %></span><% else %>—<% end %></dd>

    <dt>Release date</dt>
    <dd><%= release_date_display(movie) %></dd>

    <dt>Description</dt>
    <dd><%= movie.description.presence || "No description yet." %></dd>
  </dl>
</article>
