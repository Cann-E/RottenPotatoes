<%= form_with(model: movie, class: "movie-form") do |form| %>
  <% if movie.errors.any? %>
    <div class="error-box">
      <h2><%= pluralize(movie.errors.count, "error") %> prohibited this movie from being saved:</h2>
      <ul>
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true %>
  </div>

  <div class="field">
    <%= form.label :rating %>
    <%= form.select :rating, Movie::RATINGS, include_blank: "Choose a rating" %>
  </div>

  <div class="field">
    <%= form.label :release_date %>
    <%= form.date_field :release_date, value: movie.release_date&.to_date %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 5 %>
  </div>

  <div class="button-row">
    <%= form.submit class: "button" %>
  </div>
<% end %>
