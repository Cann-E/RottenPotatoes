<%= form_with(model: movie, class: "movie-form") do |form| %>
  <% if movie.errors.any? %>
    <div class="error-box" role="alert">
      <h2>Please fix <%= movie.errors.count == 1 ? "this problem" : "these #{movie.errors.count} problems" %>:</h2>
      <ul>
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-layout">
    <div class="form-fields">
      <div class="field">
        <%= form.label :title do %>Title <span class="required">(required)</span><% end %>
        <%= form.text_field :title, required: true %>
      </div>

      <div class="field-row">
        <div class="field">
          <%= form.label :rating %>
          <%= form.select :rating, Movie::RATINGS, include_blank: "Choose a rating" %>
        </div>

        <div class="field">
          <%= form.label :release_date %>
          <%= form.date_field :release_date, value: movie.release_date&.to_date %>
        </div>
      </div>

      <div class="field">
        <%= form.label :description %>
        <%= form.text_area :description, rows: 8 %>
      </div>

      <div class="field">
        <label for="posterFile">Poster</label>
        <div class="upload-row">
          <label for="posterFile" class="button button-secondary">Upload from PC</label>
          <input type="file" id="posterFile" class="posterFile" accept="image/*">
          <button type="button" class="link-button removePoster" <%= "hidden" if movie.poster_url.blank? %>>Remove</button>
        </div>

        <%= form.hidden_field :poster_url, class: "posterData" %>

        <input type="url" class="posterLink" placeholder="or paste an image link: https://..."
               value="<%= movie.poster_url if movie.poster_url.to_s.start_with?("http") %>">
      </div>
    </div>

    <div class="poster-preview">
      <img class="previewImg" src="<%= movie.poster_url %>" alt="Poster preview" <%= "hidden" if movie.poster_url.blank? %>>
      <p class="previewEmpty" <%= "hidden" if movie.poster_url.present? %>>No poster yet</p>
    </div>
  </div>

  <div class="button-row">
    <%= form.submit movie.persisted? ? "Save changes" : "Save movie", class: "button" %>
    <%= link_to "Cancel", cancel_path, class: "button button-secondary" %>
  </div>
<% end %>
