<% content_for :title, @movie.title %>

<section class="card">
  <%= render @movie %>

  <div class="button-row">
    <%= link_to "Edit this movie", edit_movie_path(@movie), class: "button" %>
    <%= link_to "Back to movies", movies_path, class: "button button-secondary" %>
    <%= button_to "Delete this movie", @movie, method: :delete, class: "button button-danger",
          form: { onsubmit: "return confirm('Delete this movie?');" } %>
  </div>
</section>
