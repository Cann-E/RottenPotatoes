<% content_for :title, @movie.title %>

<%= link_to "← Back to all movies", movies_path, class: "back-link" %>

<section class="card">
  <%= render @movie %>

  <div class="button-row">
    <%= link_to "Edit this movie", edit_movie_path(@movie), class: "button" %>
    <%= link_to "Back to all movies", movies_path, class: "button button-secondary" %>
  </div>
</section>

<section class="card danger-zone">
  <div>
    <h2>Delete this movie</h2>
    <p>This removes the movie from the catalog for good. It can't be undone.</p>
  </div>
  <%= button_to "Delete movie", @movie, method: :delete, class: "button button-danger",
        form: { onsubmit: "return confirm('Delete \"#{j @movie.title}\"? This cannot be undone.');" } %>
</section>
